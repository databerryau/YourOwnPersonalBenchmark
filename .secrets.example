# .secrets.example — copy this to .secrets and fill in your keys.
# .secrets is gitignored and never committed.
#
# Format: KEY=value  (one per line, no quotes needed)
# These are loaded automatically at startup before any API call is made.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Together.ai, Fireworks, etc.
# TOGETHER_API_KEY=...
# FIREWORKS_API_KEY=...

# If your local server requires a token (e.g. a custom header), set it here
# and reference it via api_key_env in config.yaml
# MY_LOCAL_TOKEN=...
